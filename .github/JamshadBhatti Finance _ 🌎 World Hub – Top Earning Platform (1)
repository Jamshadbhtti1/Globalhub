@charset "utf-8";

:root { --gold: #FFD700; --gold2: #FFA500; --dark: #060810; --dark2: #0d1120; --dark3: #131929; --accent: #00e5ff; --green: #00ff88; --text: #e8e8f0; --muted: #8890aa; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { background: var(--dark); color: var(--text); font-family: "DM Sans", sans-serif; overflow-x: hidden; }

body::before { content: ""; position: fixed; inset: 0px; background: radial-gradient(1px 1px at 10% 20%, rgba(255, 215, 0, 0.6) 0%, transparent 100%), radial-gradient(1px 1px at 30% 60%, rgba(0, 229, 255, 0.4) 0%, transparent 100%), radial-gradient(1px 1px at 70% 15%, rgba(255, 215, 0, 0.5) 0%, transparent 100%), radial-gradient(1px 1px at 90% 80%, rgba(0, 255, 136, 0.4) 0%, transparent 100%), radial-gradient(1px 1px at 55% 40%, rgba(255, 165, 0, 0.4) 0%, transparent 100%), radial-gradient(2px 2px at 20% 90%, rgba(255, 215, 0, 0.3) 0%, transparent 100%), radial-gradient(2px 2px at 80% 50%, rgba(0, 229, 255, 0.3) 0%, transparent 100%); pointer-events: none; z-index: 0; }

nav { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; background: rgba(6, 8, 16, 0.85); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 215, 0, 0.15); }

.nav-logo { font-family: "Cinzel Decorative", serif; font-size: 1.1rem; font-weight: 900; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: 1px; }

.nav-links { display: flex; gap: 32px; list-style: none; }

.nav-links a { color: var(--muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.5px; transition: color 0.3s; }

.nav-links a:hover { color: var(--gold); }

.nav-cta { background: linear-gradient(135deg, var(--gold), var(--gold2)); padding: 9px 22px; border-radius: 6px; color: rgb(6, 8, 16) !important; font-weight: 700 !important; font-size: 0.82rem !important; }

.hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 120px 24px 80px; position: relative; z-index: 1; }

.hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.3); color: var(--gold); padding: 6px 18px; border-radius: 100px; font-size: 0.78rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 32px; animation: 3s ease 0s infinite normal none running pulse; }

@keyframes pulse { 
  0%, 100% { box-shadow: rgba(255, 215, 0, 0.2) 0px 0px 0px 0px; }
  50% { box-shadow: rgba(255, 215, 0, 0.1) 0px 0px 20px 6px; }
}

.hero h1 { font-family: "Cinzel Decorative", serif; font-size: clamp(2.2rem, 6vw, 5.5rem); font-weight: 900; line-height: 1.1; margin-bottom: 12px; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(rgba(255, 215, 0, 0.25) 0px 0px 40px); animation: 1s ease 0s 1 normal both running fadeUp; }

.hero-sub { font-family: "Cinzel Decorative", serif; font-size: clamp(1rem, 2.5vw, 1.8rem); color: var(--accent); margin-bottom: 28px; letter-spacing: 3px; animation: 1s ease 0.2s 1 normal both running fadeUp; }

.hero p { font-size: clamp(1rem, 2vw, 1.2rem); color: var(--muted); max-width: 600px; line-height: 1.8; margin-bottom: 48px; animation: 1s ease 0.4s 1 normal both running fadeUp; }

@keyframes fadeUp { 
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.hero-btns { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; animation: 1s ease 0.6s 1 normal both running fadeUp; }

.btn-primary { background: linear-gradient(135deg, var(--gold), var(--gold2)); color: rgb(6, 8, 16); padding: 16px 40px; border-radius: 8px; font-weight: 700; font-size: 1rem; text-decoration: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: rgba(255, 215, 0, 0.3) 0px 8px 32px; }

.btn-primary:hover { transform: translateY(-3px); box-shadow: rgba(255, 215, 0, 0.5) 0px 16px 48px; }

.btn-outline { border: 1.5px solid rgba(0, 229, 255, 0.5); color: var(--accent); padding: 16px 40px; border-radius: 8px; font-weight: 600; font-size: 1rem; text-decoration: none; background: transparent; cursor: pointer; transition: 0.2s; }

.btn-outline:hover { background: rgba(0, 229, 255, 0.08); border-color: var(--accent); transform: translateY(-3px); }

.ticker-wrap { background: rgba(255, 215, 0, 0.06); border-top: 1px solid rgba(255, 215, 0, 0.12); border-bottom: 1px solid rgba(255, 215, 0, 0.12); overflow: hidden; padding: 12px 0px; position: relative; z-index: 1; }

.ticker { display: flex; gap: 60px; animation: 25s linear 0s infinite normal none running ticker; white-space: nowrap; }

@keyframes ticker { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

.ticker-item { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.5px; }

.ticker-item .up { color: var(--green); }

.ticker-item .down { color: rgb(255, 77, 109); }

.ticker-item .label { color: var(--muted); margin-right: 6px; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1px; background: rgba(255, 215, 0, 0.08); border-top: 1px solid rgba(255, 215, 0, 0.1); border-bottom: 1px solid rgba(255, 215, 0, 0.1); position: relative; z-index: 1; }

.stat-item { background: var(--dark2); padding: 36px 24px; text-align: center; }

